# Copia este ficheiro para ".env" e ajusta os valores.

# String de ligação MySQL. Formato:
# mysql://UTILIZADOR:PASSWORD@HOST:PORTA/NOME_DA_BASE
DATABASE_URL="mysql://root:senha@localhost:3306/lavandaria_tanque_puro"

# Segredo usado para assinar o token de sessão (JWT). Usa uma string longa e aleatória.
JWT_SECRET="troca-por-uma-string-aleatoria-bem-longa"

# URL pública onde a app está publicada (sem "/" no fim). Usado para construir o link
# do portal do cliente nas mensagens SMS. Se não definires, a app tenta adivinhar a
# partir do pedido, mas definir aqui é mais fiável em produção (ex: Vercel).
APP_URL="https://a-tua-app.vercel.app"

# --- SMS (MozeSMS — gateway moçambicano, https://www.mozesms.com/api) ---
# Fornecedor principal. Obtém a API Key/Secret em my.mozesms.com → Gestão de APIs.
MOZESMS_API_KEY="mk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MOZESMS_API_SECRET="sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Sender ID tem de estar aprovado na tua conta MozeSMS. Deixa por omissão "MozeSMS" se não tiveres um aprovado.
MOZESMS_SENDER_ID="MozeSMS"

# --- SMS (Twilio) — alternativa, só é usada se as variáveis MOZESMS_* acima não estiverem definidas ---
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_FROM_NUMBER="+1xxxxxxxxxx"

# Se nem MozeSMS nem Twilio estiverem configurados, a app corre em "modo simulação"
# (as mensagens ficam registadas na consola do servidor em vez de serem enviadas).
