generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id      Int       @id @default(autoincrement())
  nome    String
  artigos artigos[]
}

model artigos {
  id             Int            @id @default(autoincrement())
  categoria_id   Int
  nome           String         @db.VarChar(150)
  preco_base     Decimal        @db.Decimal(10, 2)
  preco_desconto Decimal        @db.Decimal(10, 2)
  disponivel     Boolean        @default(true)
  Categoria      Categoria      @relation(fields: [categoria_id], references: [id])
  fatura_itens   fatura_itens[]

  @@index([categoria_id])
}

model clientes {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(150)
  telefone  String?   @db.VarChar(30)
  endereco  String?   @db.VarChar(255)
  criado_em DateTime  @default(now())
  faturas   faturas[]
}

model fatura_itens {
  id             Int      @id @default(autoincrement())
  fatura_id      Int
  artigo_id      Int?
  nome_artigo    String   @db.VarChar(150)
  categoria      String   @db.VarChar(60)
  quantidade     Int      @default(1)
  preco_unitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  com_desconto   Boolean  @default(true)
  condicao       Json?
  sobretaxa      Decimal  @default(0) @db.Decimal(10, 2)
  artigos        artigos? @relation(fields: [artigo_id], references: [id])
  faturas        faturas  @relation(fields: [fatura_id], references: [id], onDelete: Cascade)

  @@index([artigo_id], map: "fatura_itens_artigo_id_fkey")
  @@index([fatura_id])
}

model faturas {
  id                 Int                        @id @default(autoincrement())
  numero             String                     @unique @db.VarChar(30)
  cliente_id         Int
  utilizador_id      Int?
  data_criacao       DateTime                   @default(now())
  subtotal           Decimal                    @default(0) @db.Decimal(10, 2)
  desconto           Decimal                    @default(0) @db.Decimal(10, 2)
  total              Decimal                    @default(0) @db.Decimal(10, 2)
  status             faturas_status             @default(Pendente)
  status_operacional faturas_status_operacional @default(Pendente)
  metodo_pagamento   faturas_metodo_pagamento?
  data_pagamento     DateTime?
  fatura_itens       fatura_itens[]
  clientes           clientes                   @relation(fields: [cliente_id], references: [id])
  utilizadores       utilizadores?              @relation(fields: [utilizador_id], references: [id])

  @@index([cliente_id])
  @@index([status])
  @@index([utilizador_id], map: "faturas_utilizador_id_fkey")
}

model utilizadores {
  id                   Int               @id @default(autoincrement())
  username             String            @unique @db.VarChar(50)
  password_hash        String            @db.VarChar(255)
  nome                 String            @db.VarChar(120)
  role                 utilizadores_role @default(Funcionario)
  must_change_password Boolean           @default(true)
  criado_em            DateTime          @default(now())
  faturas              faturas[]
}

enum utilizadores_role {
  Admin
  Funcionario
}

enum faturas_status {
  Pendente
  Pago
}

enum faturas_status_operacional {
  Pendente
  Em_Processo         @map("Em Processo")
  Pronto_para_Entrega @map("Pronto para Entrega")
  Entregue
  Devolvido
}

enum faturas_metodo_pagamento {
  Dinheiro
  M_Pesa                 @map("M-Pesa")
  e_Mola                 @map("e-Mola")
  mKesh
  Cart_o                 @map("Cartão")
  Transfer_ncia_Banc_ria @map("Transferência Bancária")
}
