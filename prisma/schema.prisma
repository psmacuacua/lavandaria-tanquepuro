generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id      Int      @id @default(autoincrement())
  nome    String   @unique @db.VarChar(60)
  corHex  String   @default("#24427A") @map("cor_hex") @db.VarChar(7)
  artigos Artigo[]

  @@map("categorias")
}

model Utilizador {
  id                 Int       @id @default(autoincrement())
  username           String    @unique @db.VarChar(50)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  nome               String    @db.VarChar(120)
  role               Role      @default(Funcionario)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  criadoEm           DateTime  @default(now()) @map("criado_em")
  faturas            Fatura[]
  artigosCriados     Artigo[]  @relation("ArtigoCriadoPor")
  artigosAtualizados Artigo[]  @relation("ArtigoAtualizadoPor")

  @@map("utilizadores")
}

enum Role {
  Admin
  Funcionario
}

model Cliente {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(150)
  telefone    String?  @db.VarChar(30)
  endereco    String?  @db.VarChar(255)
  portalToken String?  @unique @map("portal_token") @db.VarChar(64)
  criadoEm    DateTime @default(now()) @map("criado_em")
  faturas     Fatura[]

  @@map("clientes")
}

model Artigo {
  id               Int           @id @default(autoincrement())
  categoriaId      Int           @map("categoria_id")
  categoria        Categoria     @relation(fields: [categoriaId], references: [id])
  nome             String        @db.VarChar(150)
  precoBase        Decimal       @map("preco_base") @db.Decimal(10, 2)
  precoDesconto    Decimal       @map("preco_desconto") @db.Decimal(10, 2)
  disponivel       Boolean       @default(true)
  criadoPorId      Int?          @map("criado_por_id")
  criadoPor        Utilizador?   @relation("ArtigoCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm         DateTime      @default(now()) @map("criado_em")
  atualizadoPorId  Int?          @map("atualizado_por_id")
  atualizadoPor    Utilizador?   @relation("ArtigoAtualizadoPor", fields: [atualizadoPorId], references: [id])
  atualizadoEm     DateTime?     @updatedAt @map("atualizado_em")
  itens            FaturaItem[]

  @@index([categoriaId])
  @@map("artigos")
}

enum StatusPagamento {
  Pendente
  Pago
}

enum StatusOperacional {
  Pendente
  Em_Processo         @map("Em Processo")
  Pronto_para_Entrega @map("Pronto para Entrega")
  Entregue
  Devolvido
}

enum MetodoPagamento {
  Dinheiro
  M_Pesa               @map("M-Pesa")
  e_Mola               @map("e-Mola")
  mKesh
  Cartao               @map("Cartão")
  Transferencia_Bancaria @map("Transferência Bancária")
}

model Fatura {
  id                Int               @id @default(autoincrement())
  numero            String            @unique @db.VarChar(30)
  clienteId         Int               @map("cliente_id")
  cliente           Cliente           @relation(fields: [clienteId], references: [id])
  utilizadorId      Int?              @map("utilizador_id")
  utilizador        Utilizador?       @relation(fields: [utilizadorId], references: [id])
  dataCriacao       DateTime          @default(now()) @map("data_criacao")
  subtotal          Decimal           @default(0) @db.Decimal(10, 2)
  desconto          Decimal           @default(0) @db.Decimal(10, 2)
  ivaPercentagem    Decimal           @default(0) @map("iva_percentagem") @db.Decimal(5, 2)
  ivaValor          Decimal           @default(0) @map("iva_valor") @db.Decimal(10, 2)
  total             Decimal           @default(0) @db.Decimal(10, 2)
  status            StatusPagamento   @default(Pendente)
  statusOperacional StatusOperacional @default(Pendente) @map("status_operacional")
  metodoPagamento   MetodoPagamento?  @map("metodo_pagamento")
  dataPagamento      DateTime?        @map("data_pagamento")
  itens             FaturaItem[]

  @@index([clienteId])
  @@index([status])
  @@map("faturas")
}

model EmpresaConfig {
  id                     Int      @id @default(1)
  nome                   String   @default("Lavandaria Tanque Puro") @db.VarChar(150)
  logoUrl                String?  @map("logo_url") @db.LongText
  nuit                   String?  @db.VarChar(30)
  email                  String?  @db.VarChar(150)
  contacto               String?  @db.VarChar(60)
  endereco               String?  @db.VarChar(255)
  website                String?  @db.VarChar(150)
  contaBancaria          String?  @map("conta_bancaria") @db.VarChar(150)
  ivaAtivo               Boolean  @default(true) @map("iva_ativo")
  ivaPercentagem         Decimal  @default(16) @map("iva_percentagem") @db.Decimal(5, 2)
  sobretaxaManchaDificil Decimal  @default(50) @map("sobretaxa_mancha_dificil") @db.Decimal(10, 2)
  mostrarNuit            Boolean  @default(true) @map("mostrar_nuit")
  mostrarEndereco        Boolean  @default(true) @map("mostrar_endereco")
  mostrarEmail           Boolean  @default(false) @map("mostrar_email")
  mostrarContacto        Boolean  @default(true) @map("mostrar_contacto")
  mostrarWebsite         Boolean  @default(false) @map("mostrar_website")
  mostrarContaBancaria   Boolean  @default(false) @map("mostrar_conta_bancaria")
  mensagemPronto         String   @default("Olá {nome}, a sua roupa na {empresa} está pronta para entrega. Obrigado pela preferência!") @map("mensagem_pronto") @db.Text
  mensagemPortal         String   @default("Olá {nome}, veja o estado do seu pedido e as faturas pendentes aqui: {link}") @map("mensagem_portal") @db.Text
  mensagemPromocional    String   @default("Olá {nome}, aproveite: lave mais de 5 artigos numa só entrega e ganhe desconto especial na {empresa}!") @map("mensagem_promocional") @db.Text
  atualizadoEm           DateTime @updatedAt @map("atualizado_em")

  @@map("empresa_config")
}

model FaturaItem {
  id                Int      @id @default(autoincrement())
  faturaId          Int      @map("fatura_id")
  fatura            Fatura   @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  artigoId          Int?     @map("artigo_id")
  artigo            Artigo?  @relation(fields: [artigoId], references: [id])
  nomeArtigo        String   @map("nome_artigo") @db.VarChar(150)
  categoria         String   @db.VarChar(60)
  quantidade        Int      @default(1)
  precoBaseUnitario Decimal  @default(0) @map("preco_base_unitario") @db.Decimal(10, 2)
  precoUnitario     Decimal  @map("preco_unitario") @db.Decimal(10, 2)
  subtotal          Decimal  @db.Decimal(10, 2)
  comDesconto       Boolean  @default(true) @map("com_desconto")
  condicao          Json?    @map("condicao")
  sobretaxa         Decimal  @default(0) @map("sobretaxa") @db.Decimal(10, 2)

  @@index([faturaId])
  @@map("fatura_itens")
}
